DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/jobpilot

# Application & API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Security / Token Encryption (Fernet 32-byte urlsafe base64 key)
FERNET_KEY=wU918b0Bq_PsA5XEnvI6FmqVGRqZRXl5r42SyTjkpT4=

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
TELEGRAM_WEBHOOK_URL=

# Google OAuth (Gmail read-only)
